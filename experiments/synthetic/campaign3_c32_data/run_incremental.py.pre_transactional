#!/usr/bin/env python3
"""Resumable C3.2 raw-Monte-Carlo target execution.

Scientific mechanisms are imported unchanged from targets.py.
Production and diagnostic artifacts are strictly separated.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import sys
import tempfile
import time
from concurrent.futures import ProcessPoolExecutor
from pathlib import Path

import numpy as np
import pandas as pd

from experiments.synthetic.campaign3_c32_data import targets


ROOT = targets.ROOT

BASE = ROOT / "results" / "campaigns" / "campaign3_c32_incremental"
DIAGNOSTIC = ROOT / "results" / "diagnostics" / "campaign3_c32_incremental"

ALLOCATION = targets.FOUNDATION / "history_clock_assignment.csv"

ALLOCATION_SHA = (
    "3fbb198c20da035d2b9417487f5e0320ec8395fb204eb7329815878beaa6e1d7"
)

BATCH_SIZE = 100

SCIENTIFIC_FILES = (
    "experiments/synthetic/campaign3_c32_data/targets.py",
    "experiments/synthetic/campaign3_gate2/run.py",
    "experiments/synthetic/campaign3_horizon_pilot/run.py",
    "src/hls/campaign3_problem_generator.py",
)

PARTITION_COUNTS = {
    "TRAIN": 6300,
    "VALIDATION": 2100,
    "DEVELOPMENT_TEST": 2100,
}


def digest(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for block in iter(lambda: f.read(1024 * 1024), b""):
            h.update(block)
    return h.hexdigest()


def provenance() -> dict:
    hashes = {}
    for relative in SCIENTIFIC_FILES:
        path = ROOT / relative
        if not path.is_file():
            raise RuntimeError(f"Missing scientific source: {relative}")
        hashes[relative] = digest(path)

    return {
        "allocation_sha256": digest(ALLOCATION),
        "scientific_source_sha256": hashes,
        "python": sys.version.split()[0],
        "numpy": np.__version__,
        "pandas": pd.__version__,
        "ell": targets.ELL,
    }


def atomic_bytes(path: Path, data: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".pending_", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def atomic_json(path: Path, obj: dict) -> None:
    atomic_bytes(
        path,
        (json.dumps(obj, sort_keys=True, indent=2) + "\n").encode(),
    )


def selected_tasks(partition: str) -> list[dict]:
    if digest(ALLOCATION) != ALLOCATION_SHA:
        raise RuntimeError("Frozen allocation hash mismatch")

    data = targets.tasks(None, partition)
    data = sorted(data, key=lambda t: str(t["history_id"]))

    expected = PARTITION_COUNTS[partition]
    if len(data) != expected:
        raise RuntimeError(f"Expected {expected} states, got {len(data)}")

    ids = [str(t["history_id"]) for t in data]
    if len(ids) != len(set(ids)):
        raise RuntimeError("Duplicate history IDs")

    return data


def batch_path(directory: Path, index: int) -> tuple[Path, Path]:
    stem = f"batch_{index:04d}"
    return directory / f"{stem}.csv", directory / f"{stem}.json"


def expected_keys(batch: list[dict]) -> set[tuple[str, str, str]]:
    return {
        (str(task["history_id"]), mode, continuation)
        for task in batch
        for mode in targets.MODES
        for continuation in targets.CONTINUATIONS
    }


def validate_frame(frame: pd.DataFrame, batch: list[dict]) -> None:
    required = {
        "history_id", "selected_state_id", "partition",
        "initial_mode", "continuation", "ell",
        "raw_mc_G", "advantage_vs_Q00", "K_X",
        "future_problem_sha256", "noise_sha256",
    }
    if not required.issubset(frame.columns):
        raise RuntimeError("Missing required target columns")

    keys = list(zip(
        frame.history_id.astype(str),
        frame.initial_mode.astype(str),
        frame.continuation.astype(str),
    ))

    if len(keys) != len(batch) * 8:
        raise RuntimeError("Incorrect conceptual label count")

    if len(keys) != len(set(keys)):
        raise RuntimeError("Duplicate conceptual labels")

    if set(keys) != expected_keys(batch):
        raise RuntimeError("Incorrect batch coverage")

    expected_states = {
        str(task["history_id"]): str(task["selected_state_id"])
        for task in batch
    }

    for row in frame.itertuples(index=False):
        if str(row.selected_state_id) != expected_states[str(row.history_id)]:
            raise RuntimeError("Incorrect selected state ID")

    if not frame.ell.eq(targets.ELL).all():
        raise RuntimeError("Incorrect horizon")

    if not np.isfinite(frame.raw_mc_G.to_numpy(dtype=float)).all():
        raise RuntimeError("Nonfinite target")

    if not np.isfinite(frame.advantage_vs_Q00.to_numpy(dtype=float)).all():
        raise RuntimeError("Nonfinite advantage")

    if not frame.loc[
        frame.initial_mode == "Q00", "advantage_vs_Q00"
    ].eq(0.0).all():
        raise RuntimeError("Nonzero baseline advantage")

    for _, group in frame.groupby("history_id"):
        if group.future_problem_sha256.nunique() != 1:
            raise RuntimeError("CRN future problem mismatch")
        if group.noise_sha256.nunique() != 1:
            raise RuntimeError("CRN noise mismatch")

        for continuation, subgroup in group.groupby("continuation"):
            baseline = subgroup.loc[
                subgroup.initial_mode == "Q00", "raw_mc_G"
            ].iloc[0]

            if not np.allclose(
                subgroup.advantage_vs_Q00.to_numpy(dtype=float),
                subgroup.raw_mc_G.to_numpy(dtype=float) - baseline,
                atol=1e-12,
                rtol=0,
            ):
                raise RuntimeError("Advantage arithmetic mismatch")


def read_batch(path: Path, batch: list[dict]) -> pd.DataFrame:
    frame = pd.read_csv(
        path,
        dtype={"history_id": str, "selected_state_id": str},
    )
    validate_frame(frame, batch)
    return frame


def run_batch(batch: list[dict], workers: int) -> tuple[pd.DataFrame, int]:
    if workers == 1:
        generated = [targets.target_rows(task) for task in batch]
    else:
        with ProcessPoolExecutor(max_workers=workers) as pool:
            generated = list(
                pool.map(targets.target_rows, batch, chunksize=1)
            )

    frame = pd.DataFrame(
        row for group in generated for row in group
    ).sort_values(
        ["history_id", "continuation", "initial_mode"]
    ).reset_index(drop=True)

    validate_frame(frame, batch)

    actual_rollouts = sum(2 * group[0]["K_X"] for group in generated)
    return frame, int(actual_rollouts)


def verify_batch(
    csv_path: Path,
    manifest_path: Path,
    batch: list[dict],
    index: int,
    config: dict,
) -> bool:
    if not csv_path.exists() and not manifest_path.exists():
        return False

    if not csv_path.exists() or not manifest_path.exists():
        raise RuntimeError(
            f"Incomplete checkpoint {index}. "
            "No automatic recovery without verified provenance."
        )

    manifest = json.loads(manifest_path.read_text())
    frame = read_batch(csv_path, batch)

    checks = {
        "batch_index": index,
        "history_ids": [str(t["history_id"]) for t in batch],
        "conceptual_labels": len(batch) * 8,
        "targets_sha256": digest(csv_path),
        "run_provenance": config["provenance"],
    }

    for key, value in checks.items():
        if manifest.get(key) != value:
            raise RuntimeError(
                f"Checkpoint {index}: mismatch in {key}"
            )

    return True


def directory_for(args) -> Path:
    root = DIAGNOSTIC if args.diagnostic else BASE
    return root / args.partition.lower()


def configuration(args, prov: dict, total: int) -> dict:
    return {
        "protocol": "campaign3_c32_data_v1",
        "partition": args.partition,
        "diagnostic": args.diagnostic,
        "batch_size": args.batch_size,
        "total_states": total,
        "provenance": prov,
    }


def execute(args) -> None:
    if args.workers < 1:
        raise RuntimeError("--workers must be >= 1")
    if args.batch_size < 1:
        raise RuntimeError("--batch-size must be >= 1")
    if args.max_batches is not None and args.max_batches < 1:
        raise RuntimeError("--max-batches must be >= 1")

    if not args.diagnostic and args.batch_size != BATCH_SIZE:
        raise RuntimeError(
            "Production batch size is frozen at 100. "
            "Use --diagnostic for smaller batches."
        )

    tasks = selected_tasks(args.partition)
    batches = [
        tasks[i:i + args.batch_size]
        for i in range(0, len(tasks), args.batch_size)
    ]

    prov = provenance()
    if prov["allocation_sha256"] != ALLOCATION_SHA:
        raise RuntimeError("Allocation changed")

    config = configuration(args, prov, len(tasks))
    directory = directory_for(args)

    if args.dry_run:
        print(json.dumps({
            "execute": False,
            "directory": str(directory),
            "states": len(tasks),
            "batches": len(batches),
            "workers": args.workers,
            "batch_size": args.batch_size,
            "diagnostic": args.diagnostic,
        }, indent=2))
        return

    directory.mkdir(parents=True, exist_ok=True)
    config_path = directory / "run_config.json"

    if config_path.exists():
        if json.loads(config_path.read_text()) != config:
            raise RuntimeError("Existing run configuration differs")
    else:
        # Refuse to adopt an unconfigured directory containing batch data.
        if list(directory.glob("batch_*.csv")) or list(directory.glob("batch_*.json")):
            raise RuntimeError("Unconfigured directory contains batch artifacts")
        atomic_json(config_path, config)

    selected_batches = (
        batches[:args.max_batches]
        if args.max_batches is not None
        else batches
    )

    completed = 0
    computed = 0

    for index, batch in enumerate(selected_batches):
        csv_path, manifest_path = batch_path(directory, index)

        if verify_batch(csv_path, manifest_path, batch, index, config):
            completed += 1
            print(f"[{index+1}/{len(batches)}] verified; skipping", flush=True)
            continue

        started = time.perf_counter()
        frame, actual_rollouts = run_batch(batch, args.workers)

        payload = frame.to_csv(index=False).encode("utf-8")
        atomic_bytes(csv_path, payload)

        manifest = {
            "batch_index": index,
            "history_ids": [str(t["history_id"]) for t in batch],
            "selected_states": len(batch),
            "conceptual_labels": len(frame),
            "actual_rollouts": actual_rollouts,
            "targets_sha256": digest(csv_path),
            "run_provenance": config["provenance"],
            "elapsed_seconds": round(time.perf_counter() - started, 3),
        }
        atomic_json(manifest_path, manifest)

        computed += 1
        print(
            f"[{index+1}/{len(batches)}] "
            f"{len(batch)} states; "
            f"{actual_rollouts} rollouts; "
            f"{manifest['elapsed_seconds']} s",
            flush=True,
        )

    print(json.dumps({
        "partition": args.partition,
        "diagnostic": args.diagnostic,
        "verified_batches": completed,
        "new_batches": computed,
        "considered_batches": len(selected_batches),
        "total_batches": len(batches),
        "directory": str(directory),
    }, indent=2))


def consolidate(args) -> None:
    tasks = selected_tasks(args.partition)
    batches = [
        tasks[i:i + args.batch_size]
        for i in range(0, len(tasks), args.batch_size)
    ]

    directory = directory_for(args)
    config_path = directory / "run_config.json"

    if not config_path.exists():
        raise RuntimeError("No run configuration")

    config = json.loads(config_path.read_text())

    if config != configuration(args, provenance(), len(tasks)):
        raise RuntimeError("Run configuration/provenance mismatch")

    frames = []
    rollouts = 0

    for index, batch in enumerate(batches):
        csv_path, manifest_path = batch_path(directory, index)

        if not verify_batch(csv_path, manifest_path, batch, index, config):
            raise RuntimeError(f"Missing batch {index}")

        frames.append(read_batch(csv_path, batch))
        manifest = json.loads(manifest_path.read_text())
        rollouts += int(manifest["actual_rollouts"])

    combined = pd.concat(frames, ignore_index=True)
    validate_frame(combined, tasks)

    combined = combined.sort_values(
        ["history_id", "continuation", "initial_mode"]
    ).reset_index(drop=True)

    output = directory / "raw_mc_targets.csv"
    manifest_path = directory / "consolidation_manifest.json"

    if output.exists() or manifest_path.exists():
        raise RuntimeError("Consolidation already exists; refusing overwrite")

    atomic_bytes(output, combined.to_csv(index=False).encode())

    manifest = {
        "partition": args.partition,
        "selected_states": len(tasks),
        "conceptual_labels": len(combined),
        "actual_rollouts": rollouts,
        "targets_sha256": digest(output),
        "run_provenance": config["provenance"],
        "batch_count": len(batches),
        "batch_target_sha256": [
            json.loads(batch_path(directory, i)[1].read_text())["targets_sha256"]
            for i in range(len(batches))
        ],
    }

    atomic_json(manifest_path, manifest)
    print(json.dumps(manifest, indent=2))


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--partition",
        required=True,
        choices=tuple(PARTITION_COUNTS),
    )
    parser.add_argument("--workers", type=int, default=1)
    parser.add_argument("--batch-size", type=int, default=BATCH_SIZE)
    parser.add_argument("--max-batches", type=int)
    parser.add_argument("--diagnostic", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--consolidate", action="store_true")
    args = parser.parse_args()

    if args.dry_run and args.consolidate:
        parser.error("Choose dry-run or consolidate")

    if args.consolidate:
        consolidate(args)
    else:
        execute(args)


if __name__ == "__main__":
    main()
